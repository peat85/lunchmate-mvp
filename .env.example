# Required in production: long random string used to sign session cookies
SESSION_SECRET=change-me
# SQLite file location (default ./data/lunchmatch.db locally, /tmp/lunchmatch.db on Vercel)
DATABASE_PATH=
# Timezone used to decide what "today" means
APP_TIMEZONE=Europe/Berlin
# Public URL used in notification emails
APP_URL=http://localhost:3000
# Optional SMTP settings for email notifications (skipped if SMTP_HOST is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=LunchMatch <lunchmatch@example.com>
# Demo mode (default on): one-tap "Try the demo" sign-in + synthetic sample lunches. Set to 0 for real use.
DEMO_MODE=1
